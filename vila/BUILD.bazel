load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

config_setting(
    name = "windows-clang-cl",
    constraint_values = [
        "@platforms//os:windows",
    ],
    values = {"compiler": "clang-cl"},
)

config_setting(
    name = "llvm-clang",
    constraint_values = [
        "@platforms//os:linux",
    ],
    values = {"compiler": "clang"},
)

config_setting(
    name = "sycl",
    constraint_values = [
        "@platforms//os:windows",
        "@vila//vila/bazel/toolchains:sycl",
    ],
)

bool_flag(
    name = "with_backtrace",
    build_setting_default = False,
)

config_setting(
    name = "use_backtrace",
    flag_values = {":with_backtrace": "true"},
)

bool_flag(
    name = "with_log",
    build_setting_default = True,
)

config_setting(
    name = "use_log",
    flag_values = {":with_log": "true"},
)

cc_library(
    name = "vila",
    deps = [
        "@vila//vila/config",
        "@vila//vila/graph:dag",
        "@vila//vila/graph:route",
        "@vila//vila/logging:logger",
        "@vila//vila/profiling:timer",
        "@vila//vila/profiling:tracer",
        "@vila//vila/status",
        "@vila//vila/widget:registration",
    ],
)
