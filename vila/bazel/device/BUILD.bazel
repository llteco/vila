package(default_visibility = ["//visibility:public"])

constraint_setting(
    name = "target_sku",
    default_constraint_value = ":tgllp",
)

constraint_value(
    name = "skl",
    constraint_setting = ":target_sku",
)

constraint_value(
    name = "icelake",
    constraint_setting = ":target_sku",
)

constraint_value(
    name = "tgllp",
    constraint_setting = ":target_sku",
)

constraint_value(
    name = "adlp",
    constraint_setting = ":target_sku",
)

constraint_value(
    name = "mtl",
    constraint_setting = ":target_sku",
)

constraint_value(
    name = "lnl",
    constraint_setting = ":target_sku",
)

platform(
    name = "skylake",
