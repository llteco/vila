    name = "meteorlake",
    constraint_values = [
        "//bazel/device:mtl",
    ],
    parents = ["@local_config_platform//:host"],
)

platform(
    name = "lunarlake",
    constraint_values = [
        "//bazel/device:lnl",
    ],
    parents = ["@local_config_platform//:host"],
