    name = "tigerlake",
    constraint_values = [
        "//bazel/device:tgllp",
    ],
    parents = ["@local_config_platform//:host"],
)

platform(
    name = "alderlake",
    constraint_values = [
        "//bazel/device:adlp",
    ],
    parents = ["@local_config_platform//:host"],
)

